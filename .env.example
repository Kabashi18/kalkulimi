# ==============================================================================
# KONFIGURIMI I VARIABLAVE TË AMBIENTIT PËR PRODUKSION (VERCEL) DHE ZHVILLIM
# ==============================================================================

# 1. Porti i Serverit (për zhvillim lokal)
PORT=5000
NODE_ENV=production

# 2. Çelësi Sekret për JWT Token (Vendosni një varg të gjatë dhe të sigurt)
JWT_SECRET=sekreti_shume_i_sigurt_kalkulimi_jwt_token_2026

# 3. Lidhja me Databazën MySQL në Cloud (zgjidhni një nga dy mënyrat):
#
# Mënyra A (E rekomanduar për Cloud DB si Aiven, TiDB, Supabase, Railway, Clever Cloud):
# DATABASE_URL=mysql://user:password@host:3306/expense_tracker_db?sslmode=require
#
# Mënyra B (Me variabla individuale):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=expense_tracker_db
DB_SSL=false

# 4. Frontend API URL (opsionale në Vercel sepse rewrites e drejtojnë automatikisht te /api)
# VITE_API_URL=https://projekti-juaj.vercel.app/api
