{
  "expo": {
    "name": "Kalkulimi Shpenzimeve",
    "slug": "kalkulimi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0e7490"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalkulimi ka nevojë për qasje te fotot për të bashkangjitur faturat e shpenzimeve.",
          "cameraPermission": "Kalkulimi ka nevojë për kamerën për të fotografuar faturat e shpenzimeve.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4d73e53c-8be7-4374-a51c-a269d2d57064"
      }
    },
    "owner": "rinor31"
  }
}
